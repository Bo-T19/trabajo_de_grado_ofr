# Las bases de datos son muy pesadas: se ignora TODO el contenido de
# datos/, pero se conserva la ESTRUCTURA de carpetas (cada una trae un
# .gitkeep) para que un clon nuevo del repo ya tenga el arbol listo
# antes de correr nada -- ver config_local.py y GUIA_CODIGO.md seccion 10.
/datos/*
!/datos/grilla/
!/datos/hansen/
!/datos/gfw/
!/datos/cache/
!/datos/crudo/
!/datos/limites/
!/datos/panel/
!/datos/logs/
!/datos/ideam/

/datos/grilla/*
!/datos/grilla/.gitkeep
/datos/hansen/*
!/datos/hansen/.gitkeep
/datos/gfw/*
!/datos/gfw/.gitkeep
/datos/cache/*
!/datos/cache/.gitkeep
/datos/crudo/*
!/datos/crudo/.gitkeep
/datos/limites/*
!/datos/limites/.gitkeep
/datos/panel/*
!/datos/panel/.gitkeep
/datos/logs/*
!/datos/logs/.gitkeep
/datos/ideam/*
!/datos/ideam/.gitkeep

# Archivos de credenciales y pruebas
.dodsrc

# Cache
/__pycache__/
/legacy/fuente_dist_alert/__pycache__/

# Entorno virtual (se recrea con "python -m venv .venv" + requirements_local.txt,
# ver GUIA_CODIGO.md seccion 2.3-2.4 -- nunca debe subirse al repo)
/.venv/
